{
  "name": "Midnight",
  "description": "Cool dark blue-grey. The reference theme: it defines every token.",
  "vars": {
    "--scheme": "dark",
    "--bg": "#0f1115",
    "--card": "#181b22",
    "--surface": "#222632",
    "--border": "#2a2f3a",
    "--text": "#e6e8ee",
    "--muted": "#8b90a0",
    "--accent": "#6c8cff",
    "--accent-text": "#ffffff",
    "--danger": "#ff7a7a",
    "--warning": "#ffb35a",
    "--success": "#5ad48a",
    "--radius": "12px",
    "--font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "--shadow": "0 1px 3px rgb(0 0 0 / 40%)",
    "--overlay": "rgb(0 0 0 / 60%)",
    "--accent-2": "#a78bfa",
    "--font-display": "var(--font)",
    "--label-font": "var(--font)",
    "--label-case": "none",
    "--label-tracking": "normal",
    "--card-clip": "none",
    "--control-clip": "none",
    "--frame": "linear-gradient(var(--card), var(--card))",
    "--backdrop": "none",
    "--glow": "none"
  }
}
