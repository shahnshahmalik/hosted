{
  "name": "Weather",
  "description": "Current conditions and 3-day forecast from Open-Meteo (no API key).",
  "size": { "w": 3, "h": 3 },
  "permissions": { "hosts": ["api.open-meteo.com", "geocoding-api.open-meteo.com"], "secrets": [] },
  "props": {
    "city": { "type": "string", "label": "City", "default": "Berlin" },
    "units": { "type": "select", "label": "Units", "options": ["celsius", "fahrenheit"], "default": "celsius" }
  }
}
